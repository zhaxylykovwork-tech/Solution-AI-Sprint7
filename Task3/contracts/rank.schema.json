{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ranking recommendation v1 (no payment action)",
  "type": "object", "additionalProperties": false,
  "required": ["operationId","cutoff","featureVersion","modelVersion","status","score","reasonCodes","sourceRefs","validUntil"],
  "properties": {
    "operationId": {"type":"string","minLength":1},
    "cutoff": {"type":"string","format":"date-time"},
    "featureVersion": {"type":"string","minLength":1},
    "modelVersion": {"type":"string","minLength":1},
    "status": {"enum":["READY","ABSTAIN","FALLBACK"]},
    "score": {"type":["number","null"]},
    "reasonCodes": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "sourceRefs": {"type":"array","items":{"type":"string","minLength":1}},
    "validUntil": {"type":"string","format":"date-time"}
  },
  "allOf": [{"if":{"properties":{"status":{"const":"READY"}}},"then":{"properties":{"score":{"type":"number"},"sourceRefs":{"minItems":1}}},"else":{"properties":{"score":{"type":"null"}}}}]
}
